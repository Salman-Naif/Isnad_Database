# Isnad database service — copy this file to .env and fill in the values.
# Never commit .env to the repository — it is listed in .gitignore.
# On Railway: add these values from the Variables tab, not as a file.

# ===== API keys (required) =====

# Key the main Isnad website sends in the X-API-Key header to use this database.
# Put the same value in the main website's settings. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SITE_API_KEY=

# OpenRouter key — used here for embeddings and OCR (the chat model lives in Isnad_Website)
# Get a key at: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ===== Default user =====
# Created on the very first start, while the database has no users: the system manager, the
# only one who adds and deletes users. Set a password here (or in Railway's Variables) before
# the first start; the dashboard then asks for a new one. No password, no user.
# ADMIN_USERNAME=salman
ADMIN_PASSWORD=

# ===== Optional (defaults live in app/config.py) =====

# Storage — keep all three under one folder so one Railway Volume persists everything
# CHROMA_DIR=./chroma_db
# SQLITE_PATH=./chroma_db/isnad.db
# UPLOADS_DIR=./chroma_db/uploads
# COLLECTION_NAME=isnad_hadiths

# Accounts
# SESSION_HOURS=12
# LOGIN_ATTEMPTS_PER_15_MINUTES=10
# LOGIN_ATTEMPTS_PER_ACCOUNT_PER_15_MINUTES=20
# Interactive API docs at /docs — they list every endpoint, keep off in production
# ENABLE_API_DOCS=false

# Embeddings (OpenRouter API). Changing the model later means re-uploading all sources.
# EMBEDDING_MODEL=qwen/qwen3-embedding-4b
# Vector size asked of the model (qwen3-embedding-4b gives up to 2560; 1024 searches as well)
# EMBEDDING_DIMENSIONS=1024
# EMBEDDING_MAX_INPUT_CHARS=6000
# Text put before search queries (Qwen3 is instruction-aware); empty = built-in, - = none
# EMBEDDING_QUERY_INSTRUCTION=
# EMBEDDING_BATCH_SIZE=64
# EMBEDDING_CONCURRENCY=8        # requests at the same time
# EMBEDDING_TIMEOUT_SECONDS=60

# Document ingestion
# CHUNK_MAX_CHARS=400
# CHUNK_OVERLAP_CHARS=60
# CHUNK_MIN_LETTERS=8
# MAX_UPLOAD_MB=100

# OCR for scanned files. By default a vision model on OpenRouter reads each column, a second
# model reads it again, and a third settles disagreements (~$0.01 per scanned page).
# OCR_ENGINE=vision              # "tesseract" = free local OCR, less accurate
# OCR_MODEL=google/gemini-3-flash-preview
# OCR_CHECK_MODEL=google/gemini-3.1-flash-lite   # empty = no cross-check (about half the cost)
# OCR_REFEREE_MODEL=google/gemini-3.8-flash
# OCR_CONCURRENCY=12             # pages read at the same time
# OCR_TIMEOUT_SECONDS=180
# OCR_DPI=300
# Tesseract (fallback) — set TESSERACT_CMD only if tesseract is not on PATH
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# OCR_LANGUAGES=ara             # Arabic only; "+eng" turns Arabic into Latin junk

# Reports
# REPORT_FONT_PATH=            # TTF font with Arabic glyphs; auto-detected if empty
# REPORT_UTC_OFFSET_HOURS=3    # group stats by day in Saudi time

# LOG_LEVEL=INFO
