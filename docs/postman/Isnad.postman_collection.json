				{
					"name": "3 — البحث في المصادر",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"query\": \"{{query}}\",\n  \"top_k\": 5\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/v1/search",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"search"
							]
						},
						"description": "Finds the passages closest to {{query}}."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"البحث نجح (200)\", () => pm.response.to.have.status(200));",
									"const body = pm.response.json();",
									"const matches = body.matches || [];",
									"pm.test(\"رجعت نتائج من المصادر\", () => pm.expect(matches, \"القاعدة فارغة أو الملفات قيد المعالجة\").to.not.be.empty);",
									"",
									"// Print the results in a readable way (Postman Console, bottom-left)",
									"console.log(`===== نتائج البحث عن: ${pm.environment.get(\"query\")} =====`);",
									"matches.forEach((m, i) => console.log(",
									"  `${i + 1}) التشابه ${m.similarity} | المصدر: ${m.source}${m.hukm ? \" | الحكم: \" + m.hukm : \"\"}\\n   ${m.text}`));",
									"",
									"// Only when running with a CSV file in the Collection Runner",
									"if (pm.iterationData.has(\"expected_source\")) {",
									"  const expected = pm.iterationData.get(\"expected_source\");",
									"  const top = matches[0];",
									"  const minSim = Number(pm.iterationData.get(\"min_similarity\") || 0);",
									"  if (expected) {",
									"    pm.test(`أعلى نتيجة من المصدر المتوقع: ${expected}`, () => pm.expect(top && top.source).to.include(expected));",
									"    pm.test(`التشابه لا يقل عن ${minSim}`, () => pm.expect(top ? top.similarity : 0).to.be.at.least(minSim));",
									"  } else {",
									"    pm.test(\"لا يوجد تطابق قوي (أقل من 0.3)\", () => pm.expect(top ? top.similarity : 0).to.be.below(0.3));",
									"  }",
									"}"
								]
							}
						}
					],
					"response": [],
					"protocolProfileBehavior": {
						"disableBodyPruning": true
					}
				}
			]
		},
