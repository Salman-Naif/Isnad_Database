								"type": "text/javascript",
								"exec": [
									"pm.test(\"المفتاح مقبول (200)\", () => pm.response.to.have.status(200));",
									"const c = pm.response.json();",
									"pm.test(\"فيها إعدادات التحكم\", () => pm.expect(c).to.have.keys(",
									"  \"maintenance_mode\", \"maintenance_message\", \"search_enabled\", \"chat_enabled\", \"announcement\", \"main_site_url\"));",
									"console.log(\"إعدادات الموقع:\", JSON.stringify(c, null, 2));"
